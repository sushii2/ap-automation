{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "NODE_ENV",
        "APP_URL",
        "ENCRYPTION_*",
        "BLIND_INDEX_KEY",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "AI_GATEWAY_API_KEY",
        "WORKOS_*",
        "TRIGGER_*",
        "BLOB_*",
        "NEXT_PUBLIC_WORKOS_REDIRECT_URI"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
