  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@workspace/typescript-config": "*",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.5.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.6.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-doctor": "^0.9.23",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.3",
    "eslint-plugin-turbo": "^2.11.13",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "postcss-less": "^7.1.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "stylelint-order": "^8.1.3",
    "turbo": "^2.11.11",
    "typescript": "^5",
    "ultracite": "^8.3.1"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
