{
  "name": "ap-automation",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "keys:generate": "node packages/crypto/scripts/generate-keys.ts",
    "check": "ultracite check",
    "fix": "ultracite fix"
