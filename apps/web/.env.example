APP_URL=http://localhost:3000

# Encryption at rest — generate dev values with `npm run keys:generate`.
# Production: ENCRYPTION_PROVIDER=kms (local keyring is rejected at boot).
ENCRYPTION_PROVIDER=local
ENCRYPTION_ACTIVE_KEY_ID=
ENCRYPTION_KEYRING=
BLIND_INDEX_KEY=

# Neon Postgres. Must include sslmode=verify-full in production.
# Also set DATABASE_URL (and the encryption variables above) in the Trigger.dev
# project: the ingestion tasks write to the database.
DATABASE_URL=
# Direct (non-pooled) connection, used only by `npm run db:migrate -w web`.
DATABASE_URL_UNPOOLED=

# WorkOS AuthKit. In the WorkOS dashboard (Applications > Redirects) set:
#   Redirect URI        <APP_URL>/callback
#   Initiate login URI  <APP_URL>/sign-in
#   Sign-out URI        <APP_URL>/
# WORKOS_COOKIE_PASSWORD: `openssl rand -base64 32`
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- Trigger.dev ---
# DEV secret key from the project API Keys page in the Trigger.dev dashboard.
TRIGGER_SECRET_KEY=

# --- Invoice ingestion (used by src/trigger/ingest-invoice.ts) ---
# Document parsing. https://studio.reducto.ai
REDUCTO_API_KEY=
# Vercel AI Gateway key for the classification, extraction and embedding model calls.
AI_GATEWAY_API_KEY=

# --- Invoice chat (Claude Managed Agents, used by lib/chat) ---
# Anthropic API key. Managed Agents is called directly, not through the AI Gateway.
ANTHROPIC_API_KEY=
# Printed by `npm run chat:agent -w web`, which creates the agent and its sandbox
# environment. Re-run it after editing lib/chat/agent-config.ts.
CHAT_AGENT_ID=
CHAT_ENVIRONMENT_ID=

# --- Document storage (used by lib/document-storage.ts) ---
# Read-write token of the private Vercel Blob store. Set by Vercel on connected
# environments. Optional locally: without it, uploads are parsed but not saved.
BLOB_READ_WRITE_TOKEN=
